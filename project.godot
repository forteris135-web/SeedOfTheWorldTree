; Engine configuration file.
; It's actually a .ini file, but Godot 4 uses this extension.
; 조작 배치([input])는 GAME_DESIGN.md 8장 조작표를 따른다.
; 컨트롤러 버튼 번호: ×/A=0, ○/B=1, □/X=2, △/Y=3, 만들기/보기=4, 옵션/메뉴=6, L3(왼쪽 스틱 누르기)=7,
;   L1/LB=9, R1/RB=10, 십자키 위=11 아래=12 왼쪽=13 오른쪽=14
; 축 번호: 왼쪽 스틱 가로=0 세로=1, L2/LT=4, R2/RT=5

config_version=5

[application]

config/name="세계수의 씨앗"
config/description="멸망해 가는 몽환의 세계에서, 한 소녀가 끝을 막기 위해 걸어간다."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0784314, 0.101961, 0.164706, 1)
config/icon="res://icon.png"

[autoload]

InputDevice="*res://scripts/autoload/input_device.gd"
Juice="*res://scripts/autoload/juice.gd"
Purity="*res://scripts/autoload/purity.gd"
Game="*res://scripts/autoload/game.gd"
Progress="*res://scripts/autoload/progress.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
Settings="*res://scripts/autoload/settings.gd"
Keymap="*res://scripts/autoload/keymap.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Music="*res://scripts/autoload/music.gd"
SaveGame="*res://scripts/autoload/save_game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

